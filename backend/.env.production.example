# Copy to backend\.env (or set the same variables in the process environment).
# Production refuses SQLite, synthetic boundaries, and synthetic models.
# No Docker required — point DATABASE_URL at any reachable PostgreSQL.

ENV=production
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/risk
CORS_ORIGINS=http://localhost:3000
# After you have a public site origin, set e.g. https://your-website.example

# Windows / native paths (relative to the backend working directory):
MODELS_DIR=./models
# GEO_DIR defaults to ./data/geo — override only if needed:
# GEO_DIR=./data/geo

PREDICTION_RATE_LIMIT=30
PERSIST_PREDICTIONS=true
LOG_LEVEL=INFO

# Load balancer IPs for X-Forwarded-For (rate limits). Leave empty if clients hit the API directly.
# FORWARDED_ALLOW_IPS=10.0.0.1
