# Copy to .env (dev.ps1 setup does this for you). Lines starting with # are comments.
#
# For production, use .env.production.example instead (ENV=production + PostgreSQL).

ENV=development
# Local development: a SQLite file, no database server needed.
DATABASE_URL=sqlite:///./dev.db
# Real deployments: PostgreSQL (required when ENV=production).
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/risk
# Postgres — your database connection
DATABASE_URL=
DATABASE_URL_POOLED=

# Realtime — live SQL query subscriptions
NEON_REALTIME_URL=
NEON_REALTIME_SECRET=
CORS_ORIGINS=http://localhost:3000
MODELS_DIR=./models
PREDICTION_RATE_LIMIT=30
PERSIST_PREDICTIONS=true
LOG_LEVEL=INFO
# FORWARDED_ALLOW_IPS=
